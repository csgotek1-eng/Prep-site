# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
# Committed: contains the public site URL only, no secrets.
!.env.production

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Per-machine Claude Code permissions. Tracked by accident until
# 2026-09-24 (it pre-authorised a production deploy command in a public
# repository); untracked, and ignored so `git add -A` cannot re-add it.
.claude/settings.local.json

# Vercel
.vercel/

# Misc temporary files
*.tmp
*.temp

# Pricing calculator dev store (file-backed repository)
data/

# Cloudflare / OpenNext build output and local secrets
.open-next/
# .dev.vars and the per-environment .dev.vars.<env> secret files
.dev.vars*
.wrangler/
# Generated by `npm run cf:typegen` (eslint already ignores it)
cloudflare-env.d.ts

# Supabase CLI cache (was ignored only by the *.temp pattern above)
supabase/.temp/

# Test and coverage output, should a runner ever emit it
playwright-report/
test-results/
coverage/

# Cache-purge working files
.cache-keys*.json
