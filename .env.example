# Copy to .env.local for local development. Never commit real values —
# .env* files are gitignored. In production (e.g. Vercel) set these in the
# hosting platform's environment settings.

# Public site URL used for canonical links, Open Graph, robots and sitemap.
# Optional. When unset, a Vercel deployment resolves to its real
# *.vercel.app host (VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL) and
# local development to http://localhost:3000. Set this to the real
# production domain once the owner confirms it — do not guess one.
NEXT_PUBLIC_SITE_URL=

# --- Quote form delivery (server-side only, no NEXT_PUBLIC_ prefix) ---

# "log" (default): submissions are logged on the server, nothing external.
# "webhook": submissions are POSTed as JSON to QUOTE_WEBHOOK_URL.
QUOTE_DELIVERY_MODE=log

# Required when QUOTE_DELIVERY_MODE=webhook. Must be HTTPS in
# production (plain http is tolerated only in development).
QUOTE_WEBHOOK_URL=

# REQUIRED in production when webhook mode is enabled. Each webhook
# request includes an X-Dockentra-Signature: sha256=<hmac-sha256-of-body>
# header so the receiver can verify the payload came from this site.
QUOTE_WEBHOOK_SECRET=

# Optional. Webhook request timeout in milliseconds (default 8000).
QUOTE_WEBHOOK_TIMEOUT_MS=8000

# --- Website leads (durable lead storage) ---

# Where quote/enquiry submissions are stored durably (SAVE FIRST,
# notify second — see docs/LEAD_INTAKE_ARCHITECTURE.md).
# Usually LEAVE UNSET: leads then follow the pricing persistence
# decision below, so PRICING_PERSISTENCE=supabase covers both.
# Explicit override: "file" (development JSON store) or "supabase"
# (website_leads table, migration 0004).
LEADS_PERSISTENCE=

# Optional path for the development lead store JSON file
# (default: ./data/leads-store.json, gitignored).
LEADS_STORE_FILE=

# --- Pricing calculator persistence ---

# "file" (development only): gitignored local JSON store.
# "supabase" (production option): Supabase/Postgres via the variables
#   below. FAIL CLOSED: if supabase is selected but unconfigured, or if
#   this is unset in a production build, the pricing store is disabled —
#   there is never a silent fallback to the file store.
PRICING_PERSISTENCE=file

# Optional. Path of the JSON file used by the development pricing store
# (default: ./data/pricing-store.json, gitignored).
PRICING_STORE_FILE=

# --- Pricing calculator admin auth ---

# "dev-token" (default in development): ADMIN_ACCESS_TOKEN header check.
#   Refused automatically in production builds.
# "supabase": Supabase Auth — server-side token validation; admin role
#   comes from app_metadata.role="admin". See
#   docs/PRICING_PRODUCTION_SETUP.md for activation.
ADMIN_AUTH_PROVIDER=dev-token

# Development-only shared token for the /admin/pricing area, verified
# server-side on every /api/admin/* request. When unset, admin endpoints
# are disabled. Never valid in production. Never commit a real value.
ADMIN_ACCESS_TOKEN=

# --- Supabase (only needed for supabase persistence/auth modes) ---

# Project URL and publishable key. Both are safe in the browser by
# design — the database is protected by deny-all RLS, not by hiding
# these. They are read SERVER-SIDE (src/lib/supabase-config.ts) and
# passed to the admin login as props, so no NEXT_PUBLIC_ prefix is used
# and nothing is auto-injected into client bundles.
SUPABASE_PUBLIC_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only service-role key used by the pricing repository. MUST
# NEVER be prefixed NEXT_PUBLIC_ and never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp pricing delivery (outbound, official provider only) ---
# The calculator's "Send My Price to WhatsApp" action. When disabled or
# incomplete, pricing requests are STILL saved and shown in /admin/leads;
# the visitor is truthfully told delivery is not available (never a fake
# "sent"). See docs/WHATSAPP_PRICING_DELIVERY.md.
#   disabled (default) — save requests only, send nothing.
#   meta               — Meta WhatsApp Cloud API (requires the vars below).
WHATSAPP_DELIVERY_MODE=disabled
# Meta WhatsApp Cloud API credentials. ALL server-only: never expose
# client-side, never log, never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The APPROVED Meta message template used to send pricing (business-
# initiated conversations require an approved template; see
# docs/WHATSAPP_PRICING_DELIVERY.md for the required 3-parameter body).
WHATSAPP_PRICING_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Webhook security for /api/webhooks/whatsapp (delivery status updates).
# Verify token: any random string, must match the value entered in the
# Meta webhook configuration. App secret: the Meta app's secret, used to
# verify the X-Hub-Signature-256 HMAC on every event. Without these the
# webhook refuses all traffic (fail closed).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
