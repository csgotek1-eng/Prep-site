# Copy to .env.local for local development. Never commit real values —
# .env* files are gitignored. Production runs as a Cloudflare Worker:
# build-time public values live in .env.production (committed, public
# values only), runtime values in wrangler.jsonc "vars", and secrets via
# `wrangler secret put <NAME>` (docs/CLOUDFLARE_DEPLOYMENT.md). The
# Vercel fallbacks described below are kept for the rollback host.

# Public site URL used for canonical links, Open Graph, robots and sitemap.
# Optional. When unset, a Vercel deployment resolves to its real
# *.vercel.app host (VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL) and
# local development to http://localhost:3000. Set this to the real
# production domain once the owner confirms it — do not guess one.
NEXT_PUBLIC_SITE_URL=

# --- Quote form delivery (server-side only, no NEXT_PUBLIC_ prefix) ---

# "log" (default): submissions are logged on the server, nothing external.
# "webhook": submissions are POSTed as JSON to QUOTE_WEBHOOK_URL.
QUOTE_DELIVERY_MODE=log

# Required when QUOTE_DELIVERY_MODE=webhook. Must be HTTPS in
# production (plain http is tolerated only in development).
QUOTE_WEBHOOK_URL=

# REQUIRED in production when webhook mode is enabled. Each webhook
# request includes an X-Dockentra-Signature: sha256=<hmac-sha256-of-body>
# header so the receiver can verify the payload came from this site.
QUOTE_WEBHOOK_SECRET=

# Optional. Webhook request timeout in milliseconds (default 8000).
QUOTE_WEBHOOK_TIMEOUT_MS=8000

# --- Website leads (durable lead storage) ---

# Where quote/enquiry submissions are stored durably (SAVE FIRST,
# notify second — see docs/LEAD_INTAKE_ARCHITECTURE.md).
# Usually LEAVE UNSET: leads then follow the pricing persistence
# decision below, so PRICING_PERSISTENCE=supabase covers both.
# Explicit override: "file" (development JSON store) or "supabase"
# (website_leads table, migration 0004).
LEADS_PERSISTENCE=

# Optional path for the development lead store JSON file
# (default: ./data/leads-store.json, gitignored).
# Leave it commented to use the default: an EMPTY value is not "unset"
# (the code reads it with ??), so `NAME=` would point the store at "".
# LEADS_STORE_FILE=./data/leads-store.json

# --- Pricing calculator persistence ---

# "file" (development only): gitignored local JSON store.
# "supabase" (production option): Supabase/Postgres via the variables
#   below. FAIL CLOSED: if supabase is selected but unconfigured, or if
#   this is unset in a production build, the pricing store is disabled —
#   there is never a silent fallback to the file store.
PRICING_PERSISTENCE=file

# Optional. Path of the JSON file used by the development pricing store
# (default: ./data/pricing-store.json, gitignored).
# Leave it commented to use the default: an EMPTY value is not "unset"
# (the code reads it with ??), so `NAME=` would point the store at "".
# PRICING_STORE_FILE=./data/pricing-store.json

# --- Pricing calculator admin auth ---

# "dev-token" (default in development): ADMIN_ACCESS_TOKEN header check.
#   Refused automatically in production builds.
# "supabase": Supabase Auth — server-side token validation; admin role
#   comes from app_metadata.role="admin". See
#   docs/PRICING_PRODUCTION_SETUP.md for activation.
ADMIN_AUTH_PROVIDER=dev-token

# Development-only shared token for the /admin/pricing area, verified
# server-side on every /api/admin/* request. When unset, admin endpoints
# are disabled. Never valid in production. Never commit a real value.
ADMIN_ACCESS_TOKEN=

# --- Supabase (only needed for supabase persistence/auth modes) ---

# Project URL and publishable key. Both are safe in the browser by
# design — the database is protected by deny-all RLS, not by hiding
# these. They are read SERVER-SIDE (src/lib/supabase-config.ts) and
# passed to the admin login as props, so no NEXT_PUBLIC_ prefix is used
# and nothing is auto-injected into client bundles.
SUPABASE_PUBLIC_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only service-role key used by the pricing repository. MUST
# NEVER be prefixed NEXT_PUBLIC_ and never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp pricing delivery (outbound, official provider only) ---
# The calculator's "Send My Price to WhatsApp" action. When disabled or
# incomplete, pricing requests are STILL saved and shown in /admin/leads;
# the visitor is truthfully told delivery is not available (never a fake
# "sent"). See docs/WHATSAPP_PRICING_DELIVERY.md.
#   disabled (default) — save requests only, send nothing.
#   meta               — Meta WhatsApp Cloud API (requires the vars below).
WHATSAPP_DELIVERY_MODE=disabled
# BUILD-TIME public flag that offers WhatsApp as a delivery choice in the
# calculator (src/lib/whatsapp/pricing-channel.ts). Set it to "true" in
# .env.production at the same time as the Meta credentials, never before:
# on its own it offers visitors a channel that cannot send.
NEXT_PUBLIC_WHATSAPP_PRICING_ENABLED=
# Meta WhatsApp Cloud API credentials. ALL server-only: never expose
# client-side, never log, never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Not read by the site today; part of the Meta account record, kept so
# the set of Meta values stays in one place.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The APPROVED Meta message template used to send pricing (business-
# initiated conversations require an approved template; see
# docs/WHATSAPP_PRICING_DELIVERY.md for the required 3-parameter body).
WHATSAPP_PRICING_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Webhook security for /api/webhooks/whatsapp (delivery status updates).
# Verify token: any random string, must match the value entered in the
# Meta webhook configuration. App secret: the Meta app's secret, used to
# verify the X-Hub-Signature-256 HMAC on every event. Without these the
# webhook refuses all traffic (fail closed).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Pricing delivery by EMAIL (outbound, transactional provider) ---
# The calculator's second delivery choice: "Send my price by email".
# Same rules as WhatsApp — when disabled or incomplete, requests are
# STILL saved and shown in /admin/leads and the visitor is truthfully
# told delivery is not available (never a fake "sent").
#   disabled (default) — save requests only, send nothing.
#   resend             — Resend transactional API (requires the below).
PRICING_EMAIL_DELIVERY_MODE=disabled
# Server-only: never expose client-side, never log, never commit.
RESEND_API_KEY=
# Sender. MUST be an address on a domain VERIFIED with the provider,
# e.g. "Dockentra <pricing@dockentra.ie>". A free-mail address (gmail,
# outlook, ...) is REFUSED by the code: sending "as" one would need a
# stored mailbox password or spoofing, and neither is acceptable.
PRICING_EMAIL_FROM=
# Where customer replies should land. This MAY be a personal mailbox —
# it is only a Reply-To header, not a sending credential.
PRICING_EMAIL_REPLY_TO=

# --- Public contact email (owner) ---
# The site's primary human contact address. Until a real address is
# supplied here (or in src/lib/site-contact.ts), "Email us" opens the
# enquiry form instead of a mailto: that might go nowhere. NEVER put a
# guessed or placeholder address here.
NEXT_PUBLIC_OWNER_CONTACT_EMAIL=

# --- Owner notification for price requests ---
# Where "somebody asked for a price" lands. Defaults to the site's
# published contact address (src/lib/site-contact.ts), so this is only
# needed to send somewhere else — a preview deployment, or a shared
# inbox. A free-mail address is fine HERE: this is a recipient, not a
# sender, and the sender restriction above does not apply to it.
# Requires PRICING_EMAIL_DELIVERY_MODE=resend to send anything at all;
# with delivery disabled the lead is still saved and nothing is faked.
PRICING_NOTIFICATION_TO=

# --- Customer reviews ---
# Durable review storage, same three modes as the other stores:
#   file      development only (JSON under ./data, gitignored)
#   supabase  production; requires migration 0008_website_reviews.sql
# Unset follows PRICING_PERSISTENCE. Unconfigured = FAIL CLOSED: the
# submission endpoint answers 503 rather than accepting a review it
# cannot store, and /cases shows its empty state.
REVIEWS_PERSISTENCE=
# Optional path for the development review store
# (default: ./data/reviews-store.json, gitignored).
# Leave it commented to use the default: an EMPTY value is not "unset"
# (the code reads it with ??), so `NAME=` would point the store at "".
# REVIEWS_STORE_FILE=./data/reviews-store.json

# --- Promotions (offers, banners) ---
# Same modes as REVIEWS_PERSISTENCE: "file" for local development,
# "supabase" in production. Unset follows PRICING_PERSISTENCE; an
# unknown value disables promotions (fail closed) rather than guessing.
PROMOTIONS_PERSISTENCE=
# Optional path for the development promotions store
# (default: ./data/promotions-store.json, gitignored).
# Leave it commented to use the default: an EMPTY value is not "unset"
# (the code reads it with ??), so `NAME=` would point the store at "".
# PROMOTIONS_STORE_FILE=./data/promotions-store.json

# --- Google Analytics (GA4) ---
# The ONE value to get from Google: Admin -> Data streams -> your web
# stream -> Measurement ID, top right. It looks like G-XXXXXXXXXX.
# NOT the numeric Stream ID, NOT a UA- property, NOT a GTM- container,
# and NOT the Measurement Protocol API secret (which must never go in a
# NEXT_PUBLIC_ variable).
#
# Leave it empty and the site loads no Google script at all and the CSP
# names no Google host. Set it and redeploy — the value is inlined at
# BUILD time, so an existing build will not pick it up.
#
# Consent: there is no cookie banner on this site, so the tag loads with
# Google Consent Mode v2 defaulting every storage type to denied —
# cookieless, aggregated pings only. Full analytics needs a consent UI
# first; see src/lib/analytics.ts.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- Cloudflare Turnstile (bot protection on the public forms) ---
# The pair is all-or-nothing and is verified server-side: the token the
# browser produces is checked against Cloudflare from
# src/lib/security/turnstile.ts before anything is stored or emailed.
#
# UNSET (the default) means the widget renders nothing and the server
# SKIPS verification, so every form behaves exactly as it did before
# Turnstile existed. That is deliberate: shipping the feature must not
# take the contact form down before the owner has created a widget.
#
# Create a widget at Cloudflare dashboard -> Turnstile -> Add widget,
# add dockentra.ie (and localhost for development) to its hostnames,
# then set BOTH values below and redeploy.
#
# The SITE key is public by design and is inlined into the browser
# bundle at BUILD time, so it must be present when the build runs
# (.env.production), not only at runtime. It also drives the CSP in
# next.config.ts: with no key the policy names no Cloudflare host and
# frame-src stays 'none'.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The SECRET key. Server-only, never prefixed NEXT_PUBLIC_, never
# logged, never committed: on Cloudflare it belongs in
# `wrangler secret put TURNSTILE_SECRET_KEY`.
#
# Cloudflare publishes TEST keys for development and for the test
# suite: secret 1x0000000000000000000000000000000AA always passes and
# 2x0000000000000000000000000000000AA always fails. They are documented
# public values, not credentials.
TURNSTILE_SECRET_KEY=
