# Copy to .env.local for local development. Never commit real values —
# .env* files are gitignored. In production (e.g. Vercel) set these in the
# hosting platform's environment settings.

# Public site URL used for canonical links, Open Graph, robots and sitemap.
# Falls back to https://dockcentra.com if unset (documented fallback —
# override as soon as the production domain is confirmed).
NEXT_PUBLIC_SITE_URL=https://dockcentra.com

# --- Quote form delivery (server-side only, no NEXT_PUBLIC_ prefix) ---

# "log" (default): submissions are logged on the server, nothing external.
# "webhook": submissions are POSTed as JSON to QUOTE_WEBHOOK_URL.
QUOTE_DELIVERY_MODE=log

# Required when QUOTE_DELIVERY_MODE=webhook. Must be an http(s) URL.
QUOTE_WEBHOOK_URL=

# Optional. When set, each webhook request includes an
# X-Dockcentra-Signature: sha256=<hmac-sha256-of-body> header so the
# receiver can verify the payload came from this site.
QUOTE_WEBHOOK_SECRET=

# Optional. Webhook request timeout in milliseconds (default 8000).
QUOTE_WEBHOOK_TIMEOUT_MS=8000

# --- Pricing calculator admin (server-side only) ---

# Shared token for the /admin/pricing area, verified server-side on every
# /api/admin/* request. When unset, ALL admin endpoints are disabled.
# Development-grade auth only — see docs/PRICING_CALCULATOR.md before any
# production use. Generate a long random value; never commit a real one.
ADMIN_ACCESS_TOKEN=

# Optional. Path of the JSON file used by the development pricing store
# (default: ./data/pricing-store.json, gitignored).
PRICING_STORE_FILE=
