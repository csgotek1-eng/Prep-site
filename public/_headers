# SECURITY HEADERS FOR STATIC FILES.
#
# next.config.ts sets security headers for every path, and on Vercel
# that covered everything. On Cloudflare it does not: Workers Assets
# serves a matching static file BEFORE the Worker script runs, so a
# request for /brand/logo.png or /_next/static/chunk.js never reaches
# Next and receives none of them. Measured on the real runtime: an HTML
# route came back with 6 security headers and /brand/*.png with 0.
#
# This file is the documented Cloudflare mechanism for closing that
# gap. It is not served as an asset itself; Workers parses it and
# applies the rules to static asset responses.
#
# KEEP IN SYNC WITH next.config.ts. tests/cloudflare-deployment.test.ts
# fails if the two disagree, because the failure mode otherwise is
# silent: the site keeps working and simply stops being protected.
#
# Content-Security-Policy is deliberately NOT here. The real policy is
# assembled at build time from the configured Supabase origin and the
# Google Analytics hosts, so a copy in this file would be a second,
# stale definition of the most security-sensitive header on the site.
# CSP governs the document, and every document on this site is rendered
# by the Worker and carries the real policy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # A STATIC policy, and only for static files. It needs no build-time
  # host, so it cannot go stale the way a copy of the real CSP would.
  # On an image or a JS chunk it is inert, because a response's CSP
  # governs only when that response is itself a document. It matters
  # the day somebody drops an .svg or .html into public/: opened by
  # top-level navigation, that file would otherwise be a same-origin
  # document with no policy at all. Cloudflare does not apply _headers
  # to Worker responses, so this can never reach a real page.
  Content-Security-Policy: default-src 'none'; sandbox

# Photography and the two silent clips: big, and changed only when the
# owner swaps the files. Mirrors the /media rule in next.config.ts.
/media/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Brand assets: the header mark is requested by EVERY page and, until
# the September 2026 SEO audit, was re-fetched on every navigation with
# max-age=0. The next.config.ts rule for /brand alone did nothing here
# for the reason at the top of this file — the Worker never sees the
# request — so this is the rule that actually applies. Mirrors the
# /brand rule in next.config.ts. A day in the browser cache is enough:
# the files change only when the owner replaces them.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Content-hashed build output. A new build means a new filename, so
# these can be cached hard and forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
